{
  "firestore": {
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Questions bank"
    },
    "/exam_results/{resultId}": {
      "schema": "ExamResult",
      "description": "Final grades"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Users collection"
    },
    "/login_verifications/{tokenId}": {
      "schema": "LoginVerification",
      "description": "Security challenge tokens for unrecognized device logins"
    },
    "/tutor_sessions/{sessionId}": {
      "schema": "TutorSession",
      "description": "AI Tutor Chat history sessions"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "User feedback and ratings"
    },
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Educational news and articles"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Customer support messages"
    }
  },
  "entities": {
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "A support message from a user",
      "type": "object",
      "properties": {
        "fromEmail": { "type": "string" },
        "subject": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Article": {
      "title": "Article",
      "description": "Educational blog post or news",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "content": { "type": "string" },
        "excerpt": { "type": "string" },
        "author": { "type": "string" },
        "category": { "type": "string" },
        "image": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "views": { "type": "number" }
      },
      "required": ["title", "slug", "content"]
    },
    "Question": {
      "title": "Question",
      "description": "Exam Question",
      "type": "object",
      "properties": {
        "exam_type": { "type": "string" },
        "subject": { "type": "string" },
        "year": { "type": "number" },
        "question_text": { "type": "string" },
        "image_url": { "type": "string" },
        "options": { "type": "object" },
        "correct_answer": { "type": "string" },
        "explanation": { "type": "string" }
      }
    },
    "User": {
      "title": "User",
      "description": "A user profile",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "tier": { "type": "string" },
        "examCount": { "type": "number" }
      }
    },
    "LoginVerification": {
      "title": "LoginVerification",
      "description": "Challenge record for unrecognized authentication",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "deviceId": { "type": "string" },
        "ip": { "type": "string" },
        "location": { "type": "string" },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" },
        "verified": { "type": "boolean" },
        "used": { "type": "boolean" }
      }
    },
    "ExamResult": {
      "title": "ExamResult",
      "description": "User's test score",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "score": { "type": "number" },
        "total": { "type": "number" },
        "answers": { "type": "object" },
        "createdAt": { "type": "string" }
      }
    },
    "TutorSession": {
      "title": "TutorSession",
      "description": "AI Tutor TutorSession chat record",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "messages": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Review": {
      "title": "Review",
      "description": "User feedback and rating",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "context": { "type": "object" },
        "createdAt": { "type": "string" }
      }
    }
  }
}
