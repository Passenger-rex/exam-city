# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ALOC API Token for fetching past questions from questions.aloc.com.ng
VITE_ALOC_ACCESS_TOKEN="ALOC-78bfe77b49fb3e407bf8"

# GROQ_API_KEY: Groq API Key for AI generated content
GROQ_API_KEY="gsk_"

# VITE_FLUTTERWAVE_PUBLIC_KEY: Public key for Flutterwave client-side payment
VITE_FLUTTERWAVE_PUBLIC_KEY="MY_FLUTTERWAVE_PUBLIC_KEY"

# FLUTTERWAVE_WEBHOOK_SECRET: Secret for Flutterwave webhook signature validation
FLUTTERWAVE_WEBHOOK_SECRET="MY_WEBHOOK_SECRET"

# Supabase Realtime & Auth parameters
