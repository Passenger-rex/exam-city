rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Relaxed security rules for robust operation in staging/sandbox environments
    match /users/{userId} {
      allow read, write: if true;
    }

    match /email_verifications/{tokenId} {
      allow read, write: if true;
    }

    match /login_verifications/{tokenId} {
      allow read, write: if true;
    }

    match /questions/{questionId} {
      allow read, write: if true;
    }

    match /exam_results/{resultId} {
      allow read, write: if true;
    }

    match /referrals/{refId} {
      allow read, write: if true;
    }

    match /tutor_sessions/{sessionId} {
      allow read, write: if true;
    }

    match /reviews/{reviewId} {
      allow read, write: if true;
    }
    
    match /feedbacks/{feedbackId} {
      allow read, write: if true;
    }
    
    match /settings/{settingId} {
      allow read, write: if true;
    }
    
    match /attachments/{attachmentId} {
      allow read, write: if true;
    }
    
    match /curriculums/{curriculumId} {
      allow read, write: if true;
    }

    match /articles/{articleId} {
      allow read, write: if true;
    }

    match /support_tickets/{ticketId} {
      allow read, write: if true;
    }
  }
}



