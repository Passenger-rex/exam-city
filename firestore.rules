rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isValidLoginVerification(data) {
      return data.keys().hasAll(['uid', 'email', 'device_id', 'ip', 'location', 'created_at', 'expires_at', 'verified', 'used'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.device_id is string && data.device_id.size() <= 128
        && data.ip is string && data.ip.size() <= 128
        && data.location is string && data.location.size() <= 256
        && data.verified is bool
        && data.used is bool;
    }

    function isValidEmailVerification(data) {
      return data.keys().hasAll(['uid', 'email', 'name', 'createdAt', 'verified', 'used', 'expiresAt'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.name is string && data.name.size() <= 256
        && data.verified is bool
        && data.used is bool
        && data.expiresAt is string;
    }

    match /users/{userId} {
      allow read, list: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if (request.auth != null && request.auth.uid == userId)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerified']) && request.resource.data.emailVerified == true);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /email_verifications/{tokenId} {
      allow create: if isValidEmailVerification(request.resource.data);
      allow read: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified', 'used'])
        && request.resource.data.verified == true
        && request.resource.data.used == true;
    }

    match /login_verifications/{tokenId} {
      allow create: if isValidLoginVerification(request.resource.data);
      allow read, update: if true;
    }

    match /questions/{questionId} {
      allow read: if true;
      allow create: if request.auth != null;
    }

    match /exam_results/{resultId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /referrals/{refId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && resource.data.referrerId == request.auth.uid;
    }

    match /tutor_sessions/{sessionId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow create: if true;
      allow read: if request.auth != null;
    }
    match /feedbacks/{feedbackId} {
      allow create: if true;
      allow read: if request.auth != null;
    }
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == "johntobismart@gmail.com";
    }
    match /attachments/{attachmentId} {
      allow create: if true;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.admin == true);
    }
    match /curriculums/{curriculumId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}



